---
import { ClientRouter } from 'astro:transitions';
import { SITE, SOCIALS } from '~/utils/config';
import { PERSON_ID } from '~/utils/structured-data';
import type { Lang } from '~/i18n/ui';
import { localizedPath } from '~/i18n/paths';
import { STYLES, DEFAULT_STYLE } from '~/utils/palettes';
import { useTranslations } from '~/i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Path or URL of the 1200x630 Open Graph card. Defaults to the home card for `lang`. */
  ogImage?: string;
  canonicalURL?: string;
  /**
   * When true, the page has a sibling in the other language at the localized
   * path: hreflang alternates point at it, and the Worker redirects visitors
   * to their preferred language at the edge (src/edge/language-redirect.ts).
   */
  hasLocalizedSibling?: boolean;
  /**
   * Path of this page's translation when it lives at a different slug (blog
   * posts and listings). Ignored when `hasLocalizedSibling` is set.
   */
  translationUrl?: string;
  /** Emits `robots: noindex, follow` and drops the hreflang alternates. */
  noindex?: boolean;
  /** Extra schema.org nodes (BlogPosting, BreadcrumbList…), emitted in the same @graph as the Person. */
  structuredData?: Record<string, unknown>[];
}
const {
  title = 'Rodrigo Bustamante — Senior Software Engineer · Design Engineer & Senior FrontEnd Engineer',
  description = 'Rodrigo Bustamante — Senior Software Engineer, Design Engineer & Senior FrontEnd Engineer. 9 years building scalable frontend systems and design systems for global brands.',
  lang = 'en',
  ogImage = `/og/home/${Astro.props.lang ?? 'en'}.png`,
  canonicalURL = Astro.url.href,
  hasLocalizedSibling = false,
  translationUrl,
  noindex = false,
  structuredData = [],
} = Astro.props;

const { t } = useTranslations(lang);
const origin = Astro.site ?? Astro.url;
// Cloudflare Web Analytics: cookie-less RUM. Only rendered when a manual token
// is set (see SITE.analyticsToken); the beacon tracks ClientRouter navigations
// by default, `spa: true` just makes it explicit.
const beaconConfig = SITE.analyticsToken ? JSON.stringify({ token: SITE.analyticsToken, spa: true }) : undefined;
const ogImageAbs = new URL(ogImage, origin).href;

// hreflang alternates. Portfolio pages have a sibling at the localized path;
// blog pages name their translation, which lives at a different slug. Pages
// without a translation get no alternates.
const alternates = hasLocalizedSibling
  ? {
      en: new URL(localizedPath(Astro.url.pathname, 'en'), origin).href,
      es: new URL(localizedPath(Astro.url.pathname, 'es'), origin).href,
    }
  : translationUrl && !noindex
    ? ({ [lang]: canonicalURL, [lang === 'es' ? 'en' : 'es']: new URL(translationUrl, origin).href } as Record<
        Lang,
        string
      >)
    : undefined;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Rodrigo Bustamante',
      jobTitle: 'Senior Software Engineer · Design Engineer & Senior FrontEnd Engineer',
      url: 'https://rodrigobustamante.cl',
      image: ogImageAbs,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Madrid',
        addressCountry: 'ES',
      },
      sameAs: [SOCIALS.linkedin, SOCIALS.github, SOCIALS.x],
    },
    ...structuredData,
  ],
});
---

<!doctype html>
<html lang={lang} data-theme="light" data-lang={lang} data-fixed-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalURL} />}
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="es" href={alternates.es} />
        <link rel="alternate" hreflang="x-default" href={alternates.en} />
      </>
    )}
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <!-- JSON-LD: Person plus the page's own nodes -->
    <script type="application/ld+json" set:html={jsonLd}></script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" href="/fonts/newsreader-normal-latin.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/hanken-normal-latin.woff2" type="font/woff2" crossorigin />
    <ClientRouter />
    <slot name="head" />
    <style is:global>
      /* ——— Self-hosted fonts ——— */
      /* Subset variable instances; see public/fonts/README.md for how they are built. */
      @font-face {
        font-family: 'Newsreader';
        font-style: normal;
        font-weight: 300 500;
        font-display: optional;
        src: url('/fonts/newsreader-normal-latin-ext.woff2') format('woff2');
        unicode-range:
          U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF,
          U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Newsreader';
        font-style: normal;
        font-weight: 300 500;
        font-display: optional;
        src: url('/fonts/newsreader-normal-latin.woff2') format('woff2');
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Newsreader';
        font-style: italic;
        font-weight: 300 400;
        font-display: optional;
        src: url('/fonts/newsreader-italic-latin-ext.woff2') format('woff2');
        unicode-range:
          U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF,
          U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Newsreader';
        font-style: italic;
        font-weight: 300 400;
        font-display: optional;
        src: url('/fonts/newsreader-italic-latin.woff2') format('woff2');
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Hanken Grotesk';
        font-style: normal;
        font-weight: 400 600;
        font-display: optional;
        src: url('/fonts/hanken-normal-latin-ext.woff2') format('woff2');
        unicode-range:
          U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF,
          U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Hanken Grotesk';
        font-style: normal;
        font-weight: 400 600;
        font-display: optional;
        src: url('/fonts/hanken-normal-latin.woff2') format('woff2');
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      /* ——————————————————————————————————————————
         Design tokens
      —————————————————————————————————————————— */
      :root {
        --paper: oklch(0.975 0.01 270);
        --paper-2: oklch(0.945 0.016 272);
        --card: oklch(0.993 0.004 270);
        --ink: oklch(0.25 0.06 278);
        --ink-soft: oklch(0.38 0.06 278);
        --muted: oklch(0.47 0.045 276);
        --faint: oklch(0.6 0.035 274);
        --line: oklch(0.88 0.022 272);
        --line-soft: oklch(0.925 0.016 272);
        --accent: oklch(0.55 0.21 355);
        --accent-soft: color-mix(in oklab, oklch(0.55 0.21 355) 12%, transparent);
        --accent-ink: oklch(0.5 0.2 355);
        /* Illustration-only companions (Magenta's; each palette sets its own). */
        --accent-2: oklch(0.64 0.15 64);
        --accent-3: oklch(0.6 0.1 195);
        --on-accent: oklch(0.99 0.006 270);
        --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
        --sans: 'Hanken Grotesk', system-ui, -apple-system, sans-serif;
        --maxw: 1080px;
        --pad: clamp(20px, 5vw, 64px);
      }

      :root[data-theme='dark'] {
        --paper: oklch(0.2 0.05 278);
        --paper-2: oklch(0.235 0.058 280);
        --card: oklch(0.255 0.062 281);
        --ink: oklch(0.96 0.014 260);
        --ink-soft: oklch(0.86 0.022 262);
        --muted: oklch(0.74 0.035 266);
        --faint: oklch(0.66 0.04 268);
        --line: oklch(0.36 0.06 280);
        --line-soft: oklch(0.3 0.055 280);
        --accent: oklch(0.72 0.18 355);
        --accent-soft: color-mix(in oklab, oklch(0.72 0.18 355) 16%, transparent);
        --accent-ink: oklch(0.8 0.13 355);
        --accent-2: oklch(0.84 0.15 82);
        --accent-3: oklch(0.8 0.12 190);
        --on-accent: oklch(0.18 0.05 278);
      }

      /* Editorial style: warm paper and brown ink, the site's original look. */
      :root[data-style='editorial'] {
        --paper: oklch(0.972 0.013 79);
        --paper-2: oklch(0.945 0.016 78);
        --card: oklch(0.99 0.006 85);
        --ink: oklch(0.27 0.018 55);
        --ink-soft: oklch(0.42 0.02 52);
        --muted: oklch(0.46 0.018 55);
        --faint: oklch(0.6 0.015 60);
        --line: oklch(0.88 0.014 72);
        --line-soft: oklch(0.92 0.012 75);
        --accent: oklch(0.565 0.125 42);
        --accent-soft: color-mix(in oklab, oklch(0.565 0.125 42) 12%, transparent);
        --accent-ink: oklch(0.46 0.12 42);
        --accent-2: var(--accent);
        --accent-3: var(--accent);
        --on-accent: oklch(0.99 0.01 85);
      }

      :root[data-style='editorial'][data-theme='dark'] {
        --paper: oklch(0.205 0.012 56);
        --paper-2: oklch(0.245 0.014 56);
        --card: oklch(0.255 0.014 56);
        --ink: oklch(0.94 0.012 80);
        --ink-soft: oklch(0.82 0.014 78);
        --muted: oklch(0.68 0.016 70);
        --faint: oklch(0.62 0.016 65);
        --line: oklch(0.36 0.016 58);
        --line-soft: oklch(0.31 0.014 58);
        --accent: oklch(0.72 0.12 48);
        --accent-soft: color-mix(in oklab, oklch(0.72 0.12 48) 16%, transparent);
        --accent-ink: oklch(0.78 0.12 50);
        --on-accent: oklch(0.18 0.02 56);
      }

      /* ——— Reset ——— */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        transition:
          background 0.4s ease,
          color 0.4s ease;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button {
        font: inherit;
        color: inherit;
        background: none;
        border: 0;
        cursor: pointer;
      }
      img {
        display: block;
        max-width: 100%;
      }
      :focus-visible {
        outline: 2px solid var(--accent-ink);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .skip-link {
        position: absolute;
        top: 8px;
        left: 8px;
        z-index: 50;
        padding: 10px 16px;
        border-radius: 999px;
        background: var(--ink);
        color: var(--paper);
        font-size: 14px;
        transform: translateY(-200%);
      }
      .skip-link:focus-visible {
        transform: none;
      }
      ::selection {
        background: var(--accent-soft);
        color: var(--accent-ink);
      }

      /* ——— Layout ——— */
      .wrap {
        max-width: var(--maxw);
        margin: 0 auto;
        padding-left: var(--pad);
        padding-right: var(--pad);
      }

      /* ——— Header ——— */
      .header {
        position: sticky;
        top: 0;
        z-index: 40;
        border-bottom: 1px solid transparent;
        transition:
          background 0.3s,
          border-color 0.3s,
          backdrop-filter 0.3s;
      }
      .header.scrolled {
        background: color-mix(in oklab, var(--paper) 85%, transparent);
        backdrop-filter: blur(10px) saturate(1.2);
        border-bottom-color: var(--line);
      }
      .header-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 18px var(--pad);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }
      .wordmark {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .wordmark-name {
        font-family: var(--serif);
        font-size: 20px;
        font-weight: 500;
        letter-spacing: -0.01em;
      }
      .wordmark-dot {
        color: var(--accent);
        font-size: 20px;
        line-height: 1;
      }
      .header-nav {
        display: flex;
        gap: 26px;
      }
      .header-nav a {
        font-size: 14px;
        color: var(--ink-soft);
        position: relative;
        padding: 4px 0;
        transition: color 0.2s;
      }
      .header-nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 100%;
        bottom: 0;
        height: 1px;
        background: var(--accent);
        transition: right 0.25s ease;
      }
      .header-nav a:hover {
        color: var(--ink);
      }
      .header-nav a:hover::after {
        right: 0;
      }
      .header-tools .menu-btn {
        display: none;
      }
      .mobile-nav {
        inset: 70px var(--pad) auto auto;
        margin: 0;
        min-width: 200px;
        padding: 8px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--card);
        color: var(--ink);
        box-shadow: 0 18px 40px -20px color-mix(in oklab, var(--ink) 40%, transparent);
      }
      .mobile-nav:popover-open {
        display: flex;
        flex-direction: column;
      }
      .mobile-nav a {
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 16px;
      }
      .mobile-nav a:hover {
        background: var(--paper-2);
      }
      @media (max-width: 900px) {
        .header-nav {
          display: none;
        }
        .header-tools .menu-btn {
          display: inline-flex;
        }
      }
      /* Phones: name, language, theme and menu share one row. */
      @media (max-width: 480px) {
        .header-inner {
          gap: 12px;
        }
        .wordmark-name {
          font-size: 18px;
          white-space: nowrap;
        }
        .wordmark-dot {
          display: none;
        }
        .header-tools {
          gap: 6px;
        }
        .lang-btn {
          padding: 0 10px;
        }
      }
      .header-tools {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        height: 36px;
        padding: 0 12px;
        min-width: 36px;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 13px;
        color: var(--ink-soft);
        transition: all 0.2s;
      }
      .tool-btn:hover {
        border-color: var(--ink-soft);
        color: var(--ink);
      }
      .lang-btn .on {
        color: var(--accent-ink);
        font-weight: 600;
      }
      .lang-btn .off {
        color: var(--muted);
      }
      .lang-btn .slash {
        color: var(--line);
        margin: 0 1px;
      }

      .hero-name {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(48px, 10vw, 104px);
        line-height: 0.96;
        letter-spacing: -0.025em;
        margin-bottom: 30px;
      }

      /* ——— Buttons ——— */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        height: 50px;
        padding: 0 24px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 500;
        border: 1px solid var(--line);
        color: var(--ink);
        transition: all 0.2s ease;
      }
      .btn svg {
        width: 17px;
        height: 17px;
        flex-shrink: 0;
      }
      @media (prefers-reduced-motion: no-preference) {
        .btn:hover {
          transform: translateY(-1px);
        }
      }
      .btn-primary {
        background: var(--accent);
        color: var(--on-accent);
        border-color: var(--accent);
      }
      .btn-primary:hover {
        box-shadow: 0 10px 26px -10px color-mix(in oklab, var(--accent) 70%, transparent);
      }
      .btn-ghost:hover {
        border-color: var(--ink-soft);
        background: var(--card);
      }

      /* ——— Section scaffold ——— */
      .section {
        padding: clamp(64px, 9vh, 110px) 0;
      }
      .section + .section {
        border-top: 1px solid var(--line-soft);
      }
      .section-head {
        margin-bottom: clamp(40px, 6vh, 64px);
      }
      .section-num {
        font-family: var(--serif);
        font-style: italic;
        font-size: 16px;
        color: var(--accent-ink);
        margin-bottom: 10px;
        display: inline-block;
      }
      .section-title {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(32px, 5vw, 50px);
        line-height: 1.02;
        letter-spacing: -0.02em;
        margin-bottom: 14px;
      }
      .section-sub {
        font-size: 17px;
        color: var(--muted);
        max-width: 56ch;
        text-wrap: pretty;
      }

      /* ——— Pieces the home shares with the /system specimens ———
         The rest of the home's CSS lives in HomePage.astro. */
      .entry-company {
        font-family: var(--serif);
        font-size: clamp(24px, 3.2vw, 32px);
        font-weight: 500;
        letter-spacing: -0.015em;
        line-height: 1.1;
      }
      .entry-highlight {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        color: var(--accent-ink);
        font-weight: 500;
        margin-top: 10px;
        padding: 5px 12px 5px 10px;
        background: var(--accent-soft);
        border-radius: 999px;
      }
      .entry-highlight .star {
        display: inline-block;
        font-size: 12px;
      }
      .chip {
        font-size: 12.5px;
        color: var(--ink-soft);
        white-space: nowrap;
        padding: 4px 11px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: var(--card);
      }
      /* ——— Footer ——— */
      .footer {
        border-top: 1px solid var(--line);
      }
      .footer-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 28px var(--pad);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--muted);
      }
      .footer-socials {
        display: flex;
        gap: 16px;
      }
      .footer-links {
        display: flex;
        gap: 18px;
      }
      .footer-links a {
        transition: color 0.2s;
      }
      .footer-links a:hover {
        color: var(--accent-ink);
      }
      .footer-socials a {
        transition: color 0.2s;
        display: inline-flex;
      }
      .footer-socials a:hover {
        color: var(--accent-ink);
      }

      /* ——— Case study link ——— */
      .cs-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 20px;
        font-size: 14px;
        font-weight: 500;
        color: var(--accent-ink);
        border-bottom: 1px solid var(--accent);
        padding-bottom: 2px;
      }

      /* ——— Scroll reveal ——— */
      @media (prefers-reduced-motion: no-preference) {
        .reveal {
          opacity: 0;
          transform: translateY(16px);
          transition:
            opacity 0.7s ease,
            transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
        }
        .reveal.in {
          opacity: 1;
          transform: none;
        }
        .reveal-instant .reveal,
        .reveal-instant .reveal .chip {
          transition: none;
        }

        /* Stack chips cascade in once their entry / card is revealed. */
        .reveal :is(.entry-stack, .project-stack) .chip {
          opacity: 0;
          transform: translateY(6px);
          transition:
            opacity 0.4s ease,
            transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
        }
        .reveal.in :is(.entry-stack, .project-stack) .chip {
          opacity: 1;
          transform: none;
          transition-delay: calc(250ms + var(--chip-i, 0) * 35ms);
        }
        .chip:nth-child(2) {
          --chip-i: 1;
        }
        .chip:nth-child(3) {
          --chip-i: 2;
        }
        .chip:nth-child(4) {
          --chip-i: 3;
        }
        .chip:nth-child(5) {
          --chip-i: 4;
        }
        .chip:nth-child(6) {
          --chip-i: 5;
        }
        .chip:nth-child(7) {
          --chip-i: 6;
        }
        .chip:nth-child(8) {
          --chip-i: 7;
        }
        .chip:nth-child(9) {
          --chip-i: 8;
        }
        .chip:nth-child(10) {
          --chip-i: 9;
        }

        /* Hero intro, first page of the session only (see data-intro). */
        /* The portrait is the LCP element and is left out on purpose. */
        [data-intro] .hero-left > * {
          animation: hero-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        [data-intro] .hero-name {
          animation-delay: 70ms;
        }
        [data-intro] .hero-pitch {
          animation-delay: 140ms;
        }
        [data-intro] .hero-stats {
          animation-delay: 210ms;
        }
        [data-intro] .hero-meta {
          animation-delay: 280ms;
        }
        [data-intro] .hero-cta {
          animation-delay: 350ms;
        }

        /* Link arrows nudge in the direction they point. */
        .arrow {
          display: inline-block;
          transition: transform 0.2s ease;
        }
        .cs-link:hover .arrow {
          transform: translateX(4px);
        }
        .project-link:hover .arrow {
          transform: translate(2px, -2px);
        }
      }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        /* The highlight star twinkles while its entry is hovered. */
        .entry-highlight .star {
          transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
        }
        .entry:hover .entry-highlight .star {
          transform: rotate(90deg) scale(1.2);
        }
      }
      @keyframes hero-in {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
      }
    </style>
    <!-- Anti-FOUC: set theme, style + lang before first paint -->
    <script is:inline define:vars={{ STYLES, DEFAULT_STYLE }}>
      (function () {
        // Applies the stored theme, base style and accent palette to <html>.
        // Runs before first paint, again after every ClientRouter swap (which
        // copies the static <html> attributes), and from the header toggle.
        // Storage can throw (blocked cookies, sandboxed frames): read it as null.
        function read(key) {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        }
        // Own keys only, so a stored 'constructor' can't match the prototype.
        function pick(map, key, fallback) {
          return key && Object.prototype.hasOwnProperty.call(map, key) ? key : fallback;
        }
        function applyTheme() {
          const el = document.documentElement;
          const theme = read('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const styleName = pick(STYLES, read('style'), DEFAULT_STYLE);
          const style = STYLES[styleName];
          el.dataset.theme = theme;
          el.dataset.style = styleName.toLowerCase();
          // A palette from the other style, or one since retired, falls back to
          // this style's default.
          const p = style.palettes[pick(style.palettes, read('palette'), style.default)];
          const d = theme === 'dark';
          const accent = d ? p.d : p.l;
          el.style.setProperty('--accent', accent);
          el.style.setProperty('--accent-ink', d ? p.di : p.li);
          el.style.setProperty('--accent-2', (d ? p.d2 : p.l2) || accent);
          el.style.setProperty('--accent-3', (d ? p.d3 : p.l3) || accent);
          el.style.setProperty(
            '--accent-soft',
            'color-mix(in oklab, ' + accent + ' ' + (d ? 16 : 12) + '%, transparent)'
          );
        }
        // First page of the session: flag <html> so the hero plays its intro
        // (staggered entrance + stat count-up) once. ClientRouter swaps copy
        // the static <html> attributes, so the flag is gone after navigating.
        try {
          if (!sessionStorage.getItem('intro-seen')) {
            sessionStorage.setItem('intro-seen', '1');
            document.documentElement.dataset.intro = '';
          }
        } catch {
          // Storage blocked: skip the intro.
        }
        applyTheme();
        window.__applyTheme = applyTheme;
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skip')}
    </a>
    <slot />
    <script>
      // Scroll reveal shared by every page using this layout. Re-runs after
      // each client-side navigation; already-observed elements are skipped.
      function initReveal() {
        document.querySelectorAll<HTMLElement>('.reveal:not([data-reveal])').forEach((el) => {
          el.dataset.reveal = '';
          new IntersectionObserver(
            ([entry], observer) => {
              if (entry.isIntersecting) {
                el.classList.add('in');
                observer.disconnect();
              }
            },
            { threshold: 0 }
          ).observe(el);
        });
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);

      // On client-side navigation the view transition already animates the
      // page in, so content that lands inside the viewport is shown at once.
      // Otherwise a shared element (e.g. a case study title morphing back into
      // its /work card) would arrive inside a still-hidden .reveal parent.
      document.addEventListener('astro:after-swap', () => {
        const root = document.documentElement;
        root.classList.add('reveal-instant');
        document.querySelectorAll('.reveal').forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('in');
        });
        requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('reveal-instant')));
      });
    </script>
    {beaconConfig && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={beaconConfig}
      ></script>
    )}
  </body>
</html>
