---
import BlogLayout from '~/layouts/BlogLayout.astro';
import GradientAscii from '~/components/common/gradient-ascii/GradientAscii.astro';
import { getHomePermalink } from '~/utils/permalinks';

export const prerender = true;
---

<BlogLayout title="404 — Page Not Found" noindex>
  <div class="not-found">
    <GradientAscii options={{ shape: 'eclipse', scale: 2, cellSize: 16, glyphOpacity: 0.7, gradientOpacity: 0.5 }} />
    <div class="not-found-inner">
      <div class="not-found-num" aria-hidden="true">
        404
      </div>
      <h2>Page not found</h2>
      <p>The page you're looking for doesn't exist or has been moved.</p>
      <a href={getHomePermalink()} class="btn btn-ghost">
        Back to homepage
      </a>
    </div>
  </div>
</BlogLayout>
