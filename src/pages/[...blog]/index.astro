---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import type { ImageMetadata } from 'astro';
import BlogLayout from '~/layouts/BlogLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { localizedPath } from '~/i18n/paths';
import { useTranslations } from '~/i18n/ui';
import { blogPosting, breadcrumbs } from '~/utils/structured-data';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;
const lang: 'en' | 'es' = post.slug.startsWith('es/') ? 'es' : 'en';

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;
const ogImage = `/og/post/${post.slug}.png`;

const { t } = useTranslations(lang);
const abs = (path: string) => new URL(path, Astro.site).href;
const structuredData = [
  blogPosting({
    url: String(url),
    title: post.title,
    description: post.excerpt,
    image: abs(ogImage),
    lang,
    publishDate: post.publishDate,
    updateDate: post.updateDate,
  }),
  breadcrumbs([
    [t('nav.home'), abs(localizedPath('/', lang))],
    [t('nav.blog'), abs(`/blog/${lang}`)],
    [post.title, String(url)],
  ]),
];
---

<BlogLayout
  title={post.title}
  description={post.excerpt}
  translationUrl={post.translation}
  lang={lang}
  ogImage={ogImage}
  noindex={!blogPostRobots.index}
  structuredData={structuredData}
>
  <ToBlogLink lang={lang} />
  <SinglePost post={{ ...post, image: image }} url={url}>
    {post.Content ? <post.Content /> : <Fragment set:html={post.content || ''} />}
  </SinglePost>
  <ToBlogLink lang={lang} />
</BlogLayout>
