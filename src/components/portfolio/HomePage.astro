  /* ——— Experience timeline ——— */
  .timeline {
    --tl-aside: 132px;
    --tl-gap: clamp(20px, 4vw, 52px);
    --tl-pad: clamp(28px, 4vh, 44px);
    /* x of the rail, measured from each entry's left edge */
    --tl-x: calc(var(--tl-aside) + var(--tl-gap) / 2);
    /* y of each entry's dot, centred on the first line of .entry-years */
    --tl-dot-y: calc(var(--tl-pad) + 12px);
    --tl-dot: var(--accent);
    position: relative;
  }
  /* Rail: a faint track (::before) and an accent fill (::after) that is
     drawn by scroll where scroll-driven animations are supported. */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    top: var(--tl-dot-y);
    bottom: 0;
    left: var(--tl-x);
    width: 1px;
    background: var(--line-soft);
    pointer-events: none;
  }
  .timeline::after {
    display: none;
    background: var(--accent);
    transform-origin: top;
