  /* ——— Timeline drawn by scroll ———
     The rail's tip follows the middle of the viewport: the fill starts when
     the timeline's top reaches 50vh and completes when its bottom does.
     Each dot lights up as the tip passes it. Browsers without scroll-driven
     animations keep the static rail with lit dots. */
  @property --tl-dot {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::after {
        display: block;
        animation: tl-draw linear both;
        animation-timeline: --timeline;
        animation-range: cover 50vh cover calc(100% - 50vh);
      }
      .timeline {
        view-timeline: --timeline;
      }
      .entry {
        animation: tl-dot linear both;
        animation-timeline: view();
        animation-range: cover calc(50vh + var(--tl-dot-y) - 8px) cover calc(50vh + var(--tl-dot-y) + 8px);
      }
    }
  }
  @keyframes tl-draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes tl-dot {
    from {
      --tl-dot: var(--line);
    }
    to {
      --tl-dot: var(--accent);
    }
  }
</style>
