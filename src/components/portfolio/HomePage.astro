---
import PortfolioLayout from '~/layouts/PortfolioLayout.astro';
import SiteHeader from '~/components/portfolio/SiteHeader.astro';
import SiteFooter from '~/components/portfolio/SiteFooter.astro';
import { useTranslations, type Lang } from '~/i18n/ui';
import { localizedPath } from '~/i18n/paths';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getDatetime, getFormattedDate, getPostLang } from '~/utils/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tl } = useTranslations(lang);
// The two latest posts in this language.
const posts = (await fetchPosts()).filter((post) => getPostLang(post.slug) === lang).slice(0, 2);
