---
import { useTranslations, type Lang } from '~/i18n/ui';
import { alternateLang, localizedPath, stripLocale } from '~/i18n/paths';

interface Props {
  lang: Lang;
  variant?: 'portfolio' | 'blog';
  /** URL of this page in the other language. Defaults to the localized sibling path. */
  translationUrl?: string;
}

const { lang, variant = 'portfolio', translationUrl } = Astro.props;
const { t } = useTranslations(lang);

const otherLang = alternateLang(lang);
const homeHref = localizedPath('/', lang);
const blogHref = `/blog/${lang}`;
const isHome = stripLocale(Astro.url.pathname) === '/';
// Section anchors only work on the home page; elsewhere they point back to it.
const section = (id: string) => (isHome ? `#${id}` : localizedPath(`/#${id}`, lang));
const altUrl =
  translationUrl ?? (variant === 'blog' ? `/blog/${otherLang}` : localizedPath(Astro.url.pathname, otherLang));

const nav =
  variant === 'portfolio'
    ? [
        { href: section('work'), label: t('nav.experience') },
        { href: localizedPath('/work', lang), label: t('nav.work') },
        { href: section('skills'), label: t('nav.skills') },
        { href: section('writing'), label: t('nav.writing') },
        { href: section('contact'), label: t('nav.contact') },
      ]
    : [
        { href: homeHref, label: t('nav.home') },
        { href: blogHref, label: t('nav.blog') },
        { href: localizedPath('/#contact', lang), label: t('nav.contact') },
      ];
---

<header class="header" id="site-header" data-variant={variant} data-alt-url={altUrl}>
  <div class="header-inner">
    <a class="wordmark" href={homeHref}>
      <span class="wordmark-name">Rodrigo Bustamante</span>
      <span class="wordmark-dot" aria-hidden="true">
        ●
      </span>
    </a>
    <nav class="header-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="header-tools">
      <button class="tool-btn lang-btn" id="lang-toggle" type="button" aria-label="Toggle language">
        <span class="on">{lang === 'es' ? 'ES' : 'EN'}</span>
        <span class="slash">/</span>
        <span class="off">{lang === 'es' ? 'EN' : 'ES'}</span>
      </button>
      <button class="tool-btn" id="theme-toggle" type="button" aria-label="Toggle theme">
        <svg
          id="icon-sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display:none"
          aria-hidden="true"
        >
          <path d="M12 4.5v-2M12 21.5v-2M4.5 12h-2M21.5 12h-2M6.3 6.3L4.9 4.9M19.1 19.1l-1.4-1.4M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
        </svg>
        <svg
          id="icon-moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A8.5 8.5 0 1111.2 3a6.8 6.8 0 009.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // The theme/palette logic lives in PortfolioLayout's inline script and is
  // exposed as window.__applyTheme so it can run before first paint.
  const applyTheme = () => (window as Window & { __applyTheme?: () => void }).__applyTheme?.();

  let scrollBound = false;
  function bindScroll() {
    if (scrollBound) return;
    scrollBound = true;
    window.addEventListener(
      'scroll',
      () => document.getElementById('site-header')?.classList.toggle('scrolled', window.scrollY > 10),
      { passive: true }
    );
  }

  // Runs on first load and after every ClientRouter swap, which replaces the
  // header element and its listeners.
  function initHeader() {
    const header = document.getElementById('site-header');
    if (!header || header.dataset.bound) return;
    header.dataset.bound = '';
    bindScroll();
    requestAnimationFrame(() => header.classList.toggle('scrolled', window.scrollY > 10));

    const iconSun = document.getElementById('icon-sun') as HTMLElement | null;
    const iconMoon = document.getElementById('icon-moon') as HTMLElement | null;
    const applyThemeIcons = (theme: string) => {
      if (iconSun) iconSun.style.display = theme === 'dark' ? 'block' : 'none';
      if (iconMoon) iconMoon.style.display = theme === 'dark' ? 'none' : 'block';
    };
    applyThemeIcons(document.documentElement.dataset.theme || 'light');

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = (document.documentElement.dataset.theme || 'light') === 'light' ? 'dark' : 'light';
      localStorage.setItem('theme', next);
      applyTheme();
      applyThemeIcons(next);
    });

    document.getElementById('lang-toggle')?.addEventListener('click', () => {
      const next = (document.documentElement.dataset.lang || 'en') === 'en' ? 'es' : 'en';
      localStorage.setItem('lang', next);
      // The edge redirect (src/edge/language-redirect.ts) honours this cookie
      // over Accept-Language, so an explicit choice sticks across visits.
      document.cookie = `lang=${next};path=/;max-age=31536000;samesite=lax`;
      const altUrl = header.dataset.altUrl;
      if (altUrl) window.location.href = altUrl + window.location.hash;
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
