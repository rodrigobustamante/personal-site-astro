---
/**
 * Isometric hangar diorama for the Hangar case study header. The scene is
 * modelled in 3D units and projected here at build time, so the page ships a
 * static inline SVG whose fills are colour tokens: it follows the accent
 * palette and the light/dark theme without any runtime code. The loop (a cart
 * delivering components into the hangar) is CSS only and sits behind
 * prefers-reduced-motion; the static frame is a complete scene on its own.
 */
type V = [number, number, number];
type Shape = { d: string; cls: string };

const S = 16; // px per unit
const C = Math.cos(Math.PI / 6);
const bounds = { x0: Infinity, y0: Infinity, x1: -Infinity, y1: -Infinity };

function proj([x, y, z]: V): [number, number] {
  const p: [number, number] = [(x - y) * C * S, ((x + y) / 2 - z) * S];
  bounds.x0 = Math.min(bounds.x0, p[0]);
  bounds.x1 = Math.max(bounds.x1, p[0]);
  bounds.y0 = Math.min(bounds.y0, p[1]);
  bounds.y1 = Math.max(bounds.y1, p[1]);
  return p;
}
const r1 = (n: number) => Math.round(n * 10) / 10;
const pt = (p: V) => proj(p).map(r1).join(' ');
const poly = (pts: V[]) => `M${pts.map(pt).join('L')}Z`;
const line = (a: V, b: V) => `M${pt(a)}L${pt(b)}`;
// Screen offset of a move along the x axis, for the CSS translate.
const shiftX = (dx: number) => `${r1(dx * C * S)}px, ${r1((dx / 2) * S)}px`;

const sub = (a: V, b: V): V => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
const cross = (a: V, b: V): V => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
const dot = (a: V, b: V) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
const len = (a: V) => Math.hypot(...a);
const LIGHT: V = [0.25, 0.55, 1];
const VIEW: V = [1, 1, 1];

/** A flat face shaded by its outward normal (oriented away from `inside`); back faces are dropped. */
function face(pts: V[], mat: string, inside: V): Shape[] {
  let n = cross(sub(pts[1], pts[0]), sub(pts[2], pts[0]));
  const c = pts.reduce<V>(
    (s, p) => [s[0] + p[0] / pts.length, s[1] + p[1] / pts.length, s[2] + p[2] / pts.length],
    [0, 0, 0]
  );
  if (dot(n, sub(c, inside)) < 0) n = [-n[0], -n[1], -n[2]];
  if (dot(n, VIEW) <= 0) return [];
  const b = dot(n, LIGHT) / (len(n) * len(LIGHT));
  const tone = b > 0.8 ? 0 : b > 0.42 ? 1 : b > 0.18 ? 2 : 3;
  return [{ d: poly(pts), cls: `${mat}${tone}` }];
}

function box(x: number, y: number, z: number, dx: number, dy: number, dz: number, mat: string): Shape[] {
  const mid: V = [x + dx / 2, y + dy / 2, z + dz / 2];
  const X = x + dx,
    Y = y + dy,
    Z = z + dz;
  return [
    ...face(
      [
        [X, y, z],
        [X, Y, z],
        [X, Y, Z],
        [X, y, Z],
      ],
      mat,
      mid
    ),
    ...face(
      [
        [x, Y, z],
        [X, Y, z],
        [X, Y, Z],
        [x, Y, Z],
      ],
      mat,
      mid
    ),
    ...face(
      [
        [x, y, Z],
        [X, y, Z],
        [X, Y, Z],
        [x, Y, Z],
      ],
      mat,
      mid
    ),
  ];
}

/** A body of revolution along the x axis: rings at each station, joined by quads. */
function loft(stations: { x: number; r: number; z: number }[], yc: number, mat: string, sides = 12): Shape[] {
  const rings = stations.map(({ x, r, z }) =>
    Array.from({ length: sides }, (_, k): V => {
      const a = (2 * Math.PI * (k + 0.5)) / sides;
      return [x, yc + r * Math.cos(a), z + r * Math.sin(a)];
    })
  );
  const out: Shape[] = [];
  for (let i = 0; i < rings.length - 1; i++) {
    const inside: V = [(stations[i].x + stations[i + 1].x) / 2, yc, (stations[i].z + stations[i + 1].z) / 2];
    for (let k = 0; k < sides; k++) {
      const k2 = (k + 1) % sides;
      out.push(...face([rings[i][k], rings[i + 1][k], rings[i + 1][k2], rings[i][k2]], mat, inside));
    }
  }
  const last = stations.length - 1;
  out.push(...face(rings[last], mat, [stations[last - 1].x, yc, stations[last - 1].z]));
  return out;
}

/* ——— Scene ——— */

// Apron slab
const AX = 24,
  AY = 19.5,
  AZ = 0.8;
const slab = [
  ...face(
    [
      [AX, 0, -AZ],
      [AX, AY, -AZ],
      [AX, AY, 0],
      [AX, 0, 0],
    ],
    'ground',
    [0, 0, -1]
  ),
  ...face(
    [
      [0, AY, -AZ],
      [AX, AY, -AZ],
      [AX, AY, 0],
      [0, AY, 0],
    ],
    'ground',
    [0, 0, -1]
  ),
  ...face(
    [
      [0, 0, 0],
      [AX, 0, 0],
      [AX, AY, 0],
      [0, AY, 0],
    ],
    'ground',
    [0, 0, -1]
  ),
];

// Hangar: barrel roof spanning y, open towards +x
const H = { x0: 1, x1: 9, y0: 1, y1: 10, h: 3.2, rise: 2.2 };
const hyc = (H.y0 + H.y1) / 2;
const hr = (H.y1 - H.y0) / 2;
const arc = (t: number): [number, number] => [hyc + hr * Math.cos(t), H.h + H.rise * Math.sin(t)];
const ARC = 12;
const arcPts = Array.from({ length: ARC + 1 }, (_, i) => arc((Math.PI * i) / ARC));
const hMid: V = [(H.x0 + H.x1) / 2, hyc, H.h / 2];
const hangar = [
  ...face(
    [
      [H.x0, H.y1, 0],
      [H.x1, H.y1, 0],
      [H.x1, H.y1, H.h],
      [H.x0, H.y1, H.h],
    ],
    'wall',
    hMid
  ),
  ...arcPts.slice(0, -1).flatMap(([ya, za], i) => {
    const [yb, zb] = arcPts[i + 1];
    return face(
      [
        [H.x0, ya, za],
        [H.x1, ya, za],
        [H.x1, yb, zb],
        [H.x0, yb, zb],
      ],
      'roof',
      [hMid[0], hyc, H.h - 1]
    );
  }),
  ...face([[H.x1, H.y0, 0], [H.x1, H.y1, 0], ...arcPts.map(([y, z]): V => [H.x1, y, z])], 'wall', hMid),
];
const D = { y0: 2, y1: 9, h: 4 };
const doorPath = poly([
  [H.x1, D.y0, 0],
  [H.x1, D.y1, 0],
  [H.x1, D.y1, D.h],
  [H.x1, D.y0, D.h],
]);
const interior = {
  floor: poly([
    [H.x0, H.y0, 0],
    [H.x1, H.y0, 0],
    [H.x1, H.y1, 0],
    [H.x0, H.y1, 0],
  ]),
  side: poly([
    [H.x0, H.y0, 0],
    [H.x1, H.y0, 0],
    [H.x1, H.y0, H.h],
    [H.x0, H.y0, H.h],
  ]),
};
// The component library already on the floor, and the slots the cart fills.
const MATS = ['roof', 'soft', 'deep'];
const library = [2.4, 3.3, 6.1, 7.0, 7.9].map((y, i) => box(6.2, y, 0, 0.8, 0.8, 0.8, MATS[(i + 1) % 3]));
const delivered = [3.6, 4.5, 5.4].map((y, i) => box(7.4, y, 0, 0.8, 0.8, 0.8, MATS[i]));

// Cart, parked mid-lane in the static frame
const LANE = 4.5;
const CX = 15.5;
const cart = [
  ...box(CX, LANE - 0.45, 0.15, 1.1, 0.9, 0.6, 'roof'),
  ...box(CX + 0.25, LANE - 0.3, 0.75, 0.5, 0.6, 0.35, 'deep'),
  ...box(CX + 1.3, LANE - 0.5, 0.15, 2.1, 1, 0.2, 'wall'),
  ...MATS.flatMap((m, i) => box(CX + 1.4 + i * 0.65, LANE - 0.27, 0.35, 0.55, 0.55, 0.55, m)),
];
const cartShadow = poly([
  [CX - 0.1, LANE - 0.6, 0],
  [CX + 3.5, LANE - 0.6, 0],
  [CX + 3.5, LANE + 0.6, 0],
  [CX - 0.1, LANE + 0.6, 0],
]);

// Plane, nose towards +x
const yc = 13.5;
const fuselage = loft(
  [
    { x: 10.9, r: 0.12, z: 2.05 },
    { x: 12, r: 0.5, z: 1.75 },
    { x: 13.5, r: 0.85, z: 1.45 },
    { x: 20.4, r: 0.85, z: 1.45 },
    { x: 21.6, r: 0.7, z: 1.38 },
    { x: 22.4, r: 0.42, z: 1.28 },
    { x: 22.85, r: 0.1, z: 1.2 },
  ],
  yc,
  'body'
);
const WZ = 1.0;
const wing = (s: 1 | -1): Shape[] => {
  const pts: V[] = [
    [18, yc + s * 0.8, WZ],
    [15.2, yc + s * 0.8, WZ],
    [13.6, yc + s * 5.2, WZ],
    [14.9, yc + s * 5.2, WZ],
  ];
  const lead: V[] = [
    [18, yc + s * 0.8, WZ],
    [14.9, yc + s * 5.2, WZ],
    [14.9, yc + s * 5.2, WZ - 0.14],
    [18, yc + s * 0.8, WZ - 0.14],
  ];
  return [...face(lead, 'body', [15, yc, WZ - 1]), ...face(pts, 'body', [15, yc, WZ - 1])];
};
const stab = (s: 1 | -1): Shape[] =>
  face(
    [
      [12.7, yc + s * 0.3, 2],
      [11.4, yc + s * 0.3, 2],
      [10.9, yc + s * 2.3, 2],
      [11.6, yc + s * 2.3, 2],
    ],
    'body',
    [12, yc, 1]
  );
const engine = (s: 1 | -1) =>
  loft(
    [
      { x: 16, r: 0.28, z: 0.5 },
      { x: 16.5, r: 0.4, z: 0.5 },
      { x: 18.4, r: 0.4, z: 0.5 },
      { x: 18.6, r: 0.36, z: 0.5 },
    ],
    yc + s * 2.6,
    'soft',
    10
  );
const fin = face(
  [
    [11.2, yc, 2.1],
    [13.1, yc, 2.1],
    [11.95, yc, 4.05],
    [11.05, yc, 4.05],
  ],
  'roof',
  [12, yc - 1, 3]
);
const gear = (x: number, y: number, top: number) => line([x, y, top], [x, y, 0]);
const planeShadow = [
  poly([
    [18.3, yc - 0.8, 0],
    [15, yc - 0.8, 0],
    [13.4, yc - 5.4, 0],
    [14.9, yc - 5.4, 0],
  ]),
  poly([
    [18.3, yc + 0.8, 0],
    [15, yc + 0.8, 0],
    [13.4, yc + 5.4, 0],
    [14.9, yc + 5.4, 0],
  ]),
  poly([
    [11, yc - 0.7, 0],
    [22.6, yc - 0.7, 0],
    [22.6, yc + 0.7, 0],
    [11, yc + 0.7, 0],
  ]),
];
const winA = 0.6; // window row, just above the +y side of the fuselage
const windows = line(
  [13.9, yc + 0.85 * Math.cos(winA), 1.45 + 0.85 * Math.sin(winA)],
  [20.1, yc + 0.85 * Math.cos(winA), 1.45 + 0.85 * Math.sin(winA)]
);
const cheat = line([13.5, yc + 0.85, 1.45], [20.4, yc + 0.85, 1.45]);
const cockpit = line([21.45, yc + 0.42, 1.88], [22.02, yc + 0.28, 1.66]);

// Markings and beacons
const lanePath = line([H.x1 + 0.2, LANE, 0], [AX - 0.4, LANE, 0]);
const standPath = line([H.x1 + 1.2, yc, 0], [AX - 0.4, yc, 0]);
const stopBar = line([23, yc - 1.2, 0], [23, yc + 1.2, 0]);
const beacons = [
  [H.x1, hyc, H.h + H.rise + 0.15],
  [11.5, yc, 4.1],
  [14.25, yc + 5.25, WZ + 0.05],
  [14.25, yc - 5.25, WZ + 0.05],
].map((p) => proj(p as V).map(r1));

// Painter's order: far side, fuselage and fin, then the near side (whose gear,
// livery and windows go in between, in the template).
const planeBack = [...stab(-1), ...engine(-1), ...wing(-1), ...fuselage, ...fin, ...stab(1)];
const planeFront = [...engine(1), ...wing(1)];

const PAD = 6;
const viewBox = [bounds.x0 - PAD, bounds.y0 - PAD, bounds.x1 - bounds.x0 + PAD * 2, bounds.y1 - bounds.y0 + PAD * 2]
  .map(r1)
  .join(' ');

// Tones 0 (lit) … 3 (shaded) mix each base towards --ink; the amounts flip in
// dark mode, where --ink is the light end.
const BASES: Record<string, string> = {
  ground: 'var(--paper-2)',
  wall: 'var(--dio-wall)',
  body: 'var(--dio-body)',
  roof: 'var(--accent)',
  soft: 'color-mix(in oklab, var(--accent) 40%, var(--card))',
  deep: 'color-mix(in oklab, var(--ink) 65%, var(--accent))',
};
const toneCss = Object.entries(BASES)
  .flatMap(([m, base]) =>
    [0, 1, 2, 3].map((i) => `.dio .${m}${i}{--f:color-mix(in oklab, ${base}, var(--ink) var(--dio-k${i}))}`)
  )
  .join('');

// The SVG is emitted as one string: rendered through the template, each of
// its ~200 paths would also carry Astro's scoping attribute.
const paths = (list: Shape[]) => list.map((s) => `<path d="${s.d}" class="${s.cls}"/>`).join('');
const mark = (cls: string, d: string, style = '') => `<path class="${cls}" d="${d}"${style && ` style="${style}"`}/>`;
const svg = [
  `<defs><clipPath id="dio-hangar-door"><path d="${doorPath}"/></clipPath></defs>`,
  paths(slab),
  mark('dio-lane', lanePath),
  mark('dio-stand', standPath),
  mark('dio-stand', stopBar),
  paths(hangar),
  mark('dio-void', doorPath),
  '<g clip-path="url(#dio-hangar-door)">',
  mark('dio-void-floor', interior.floor),
  mark('dio-void-side', interior.side),
  ...library.map((b) => `<g>${paths(b)}</g>`),
  ...delivered.map((b, i) => `<g class="dio-drop" style="--i:${i}">${paths(b)}</g>`),
  '</g>',
  `<g class="dio-cart" style="--from:${shiftX(22 - CX)};--to:${shiftX(9.6 - CX)}">`,
  mark('dio-shadow', cartShadow),
  paths(cart),
  '</g>',
  ...planeShadow.map((d) => mark('dio-shadow', d)),
  mark('dio-gear', gear(21, yc, 1)),
  mark('dio-gear', gear(16.2, yc - 0.9, 0.9)),
  paths(planeBack),
  mark('dio-cheat', cheat),
  mark('dio-windows', windows),
  mark('dio-cockpit', cockpit),
  mark('dio-gear', gear(16.2, yc + 0.9, 0.9)),
  paths(planeFront),
  ...beacons.map(([x, y], i) => `<circle class="dio-beacon" cx="${x}" cy="${y}" r="2.4" style="--i:${i}"/>`),
].join('');
---

<figure class="dio" aria-hidden="true">
  <style is:inline set:html={toneCss}></style>
  <svg viewBox={viewBox} focusable="false" set:html={svg} />
</figure>

<style is:global>
  .dio {
    --dio-k0: 0%;
    --dio-k1: 9%;
    --dio-k2: 18%;
    --dio-k3: 30%;
    --dio-wall: var(--card);
    --dio-body: var(--card);
    --dio-void: color-mix(in oklab, var(--ink) 85%, var(--paper));
    margin: 48px 0 0;
  }
  :root[data-theme='dark'] .dio {
    --dio-k0: 28%;
    --dio-k1: 18%;
    --dio-k2: 9%;
    --dio-k3: 2%;
    /* Lift the volumes off the dark apron; the plane reads as the lightest. */
    --dio-wall: color-mix(in oklab, var(--ink) 22%, var(--card));
    --dio-body: color-mix(in oklab, var(--ink) 58%, var(--card));
    --dio-void: color-mix(in oklab, var(--paper), var(--ink) 5%);
  }
  .dio svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .dio path {
    fill: var(--f);
    stroke: var(--f);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }
  .dio .dio-void {
    fill: var(--dio-void);
  }
  .dio .dio-void-floor {
    fill: color-mix(in oklab, var(--dio-void), var(--paper) 14%);
  }
  .dio .dio-void-side {
    fill: color-mix(in oklab, var(--dio-void), var(--paper) 6%);
  }
  .dio .dio-shadow {
    fill: var(--ink);
    opacity: 0.07;
  }
  .dio .dio-lane,
  .dio .dio-stand,
  .dio .dio-cheat {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .dio .dio-lane {
    stroke-dasharray: 7 6;
    opacity: 0.6;
  }
  .dio .dio-stand {
    opacity: 0.35;
  }
  .dio .dio-gear {
    stroke: var(--dio-void);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .dio .dio-windows {
    stroke: var(--dio-void);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 0 4;
  }
  .dio .dio-cockpit {
    stroke: var(--dio-void);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .dio .dio-beacon {
    fill: var(--accent);
    stroke: color-mix(in oklab, var(--accent) 35%, transparent);
    stroke-width: 3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dio .dio-cart {
      animation: dio-cart 12s cubic-bezier(0.45, 0, 0.4, 1) infinite both;
    }
    .dio .dio-drop {
      animation: dio-drop 12s cubic-bezier(0.3, 1.4, 0.5, 1) infinite both;
      animation-delay: calc(var(--i) * 0.35s);
    }
    .dio .dio-beacon {
      animation: dio-blink 2.4s steps(1) infinite both;
      animation-delay: calc(var(--i) * -0.6s);
    }
    .dio[data-paused] * {
      animation-play-state: paused;
    }
  }
  /* The cart rolls in from the apron edge, enters the hangar and fades. */
  @keyframes dio-cart {
    0% {
      transform: translate(var(--from));
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    44% {
      transform: translate(var(--to));
      opacity: 1;
    }
    49%,
    100% {
      transform: translate(var(--to));
      opacity: 0;
    }
  }
  /* Its load then drops into the free slots of the library, and clears
     before the next run. */
  @keyframes dio-drop {
    0%,
    48% {
      transform: translateY(-12px);
      opacity: 0;
    }
    54%,
    90% {
      transform: none;
      opacity: 1;
    }
    95%,
    100% {
      transform: none;
      opacity: 0;
    }
  }
  @keyframes dio-blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
</style>

<script>
  // Pause the loop while the diorama is off screen.
  function initDioramas() {
    document.querySelectorAll<HTMLElement>('.dio:not([data-io])').forEach((el) => {
      el.dataset.io = '';
      new IntersectionObserver(([entry]) => el.toggleAttribute('data-paused', !entry.isIntersecting)).observe(el);
    });
  }
  initDioramas();
  document.addEventListener('astro:page-load', initDioramas);
</script>
