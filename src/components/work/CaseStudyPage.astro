---
import { render, type CollectionEntry } from 'astro:content';
import PortfolioLayout from '~/layouts/PortfolioLayout.astro';
import SiteHeader from '~/components/portfolio/SiteHeader.astro';
import { useTranslations, type Lang } from '~/i18n/ui';
import { localizedPath } from '~/i18n/paths';
import { workSlug } from '~/utils/work';

interface Props {
  entry: CollectionEntry<'work'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const { t } = useTranslations(lang);
const { Content } = await render(entry);
const { data } = entry;
const slug = workSlug(entry);
const meta = [
  ['work.meta.role', data.role],
  ['work.meta.period', data.period],
  ['work.meta.scope', data.scope],
  ['work.meta.stack', data.stack.join(', ')],
] as const;
---

<PortfolioLayout
  title={`${data.title} — Rodrigo Bustamante`}
  description={data.subtitle}
  lang={lang}
  ogImage={`/og/work/${slug}/${lang}.png`}
  hasLocalizedSibling
>
  <SiteHeader lang={lang} variant="portfolio" />

  <main>
    <article class="cs-wrap">
      <a class="back-link" href={localizedPath('/work', lang)}>
        {t('work.back')}
      </a>

      <header class="cs-header">
        <span class="cs-tag">{data.tag}</span>
        <h1 class="cs-title">{data.title}</h1>
        <p class="cs-subtitle">{data.subtitle}</p>
      </header>

      <div class="cs-meta">
        {meta.map(([key, value]) => (
          <div class="cs-meta-item">
            <span class="cs-meta-k">{t(key)}</span>
            <span class="cs-meta-v">{value}</span>
          </div>
        ))}
      </div>

      <Content />
    </article>
  </main>
</PortfolioLayout>

<style is:global>
  .cs-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(48px, 8vh, 96px) var(--pad) clamp(64px, 10vh, 120px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 40px;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--ink);
  }

  .cs-tag {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    font-weight: 600;
    margin-bottom: 18px;
  }
  .cs-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }
  .cs-subtitle {
    font-family: var(--serif);
    font-size: clamp(18px, 2.4vw, 24px);
    color: var(--ink-soft);
    line-height: 1.45;
    font-weight: 300;
    max-width: 52ch;
    text-wrap: pretty;
  }

  .cs-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    overflow: hidden;
    margin: 48px 0 0;
  }
  .cs-meta-item {
    background: var(--paper);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cs-meta-k {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cs-meta-v {
    font-size: 14.5px;
    color: var(--ink);
    line-height: 1.4;
  }

  .cs-section {
    margin-top: clamp(56px, 8vh, 88px);
    padding-top: clamp(40px, 6vh, 64px);
    border-top: 1px solid var(--line-soft);
  }
  .cs-section--highlight {
    background: var(--accent-soft);
    border: 1px solid color-mix(in oklab, var(--accent) 20%, transparent);
    border-radius: 14px;
    padding: clamp(28px, 4vh, 44px) clamp(24px, 3vw, 40px);
    margin-top: clamp(56px, 8vh, 88px);
  }
  .cs-section-label {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent-ink);
    font-weight: 600;
    margin-bottom: 14px;
  }
  .cs-section-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(26px, 3.5vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }
  .cs-section p,
  .cs-pillar p {
    font-size: 16.5px;
    color: var(--ink-soft);
    line-height: 1.65;
    text-wrap: pretty;
    margin-bottom: 16px;
  }
  .cs-section p:last-child,
  .cs-pillar p:last-child {
    margin-bottom: 0;
  }

  .cs-pillars {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .cs-pillar-h {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .cs-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    overflow: hidden;
  }
  @media (max-width: 560px) {
    .cs-metrics {
      grid-template-columns: 1fr;
    }
  }
  .cs-metric {
    background: var(--paper);
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cs-metric-k {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .cs-metric-v {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>
