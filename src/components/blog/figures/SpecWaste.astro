---
/**
 * Six preloaded pages, the server load they cost, and the two the user
 * actually visited.
 */
import Figure from './Figure.astro';
import { finalStep, type Lang } from './beats';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = {
  es: {
    summary: 'Seis páginas precargadas y una barra con la carga del servidor.',
    steps: [
      'Se precargan seis páginas: son datos que el usuario paga',
      'Cada precarga es una petición más al servidor',
      'Solo visitó dos: el resto fue desperdicio',
    ],
    pages: ['/precios', '/blog', '/contacto', '/equipo', '/checkout', '/faq'],
    preloaded: 'Precargada',
    used: 'Visitada',
    unused: 'Sin usar',
    server: 'Carga del servidor',
  },
  en: {
    summary: 'Six preloaded pages and a bar with the server load.',
    steps: [
      'Six pages are preloaded: data the user pays for',
      'Every preload is one more request to the server',
      'They only visited two: the rest was waste',
    ],
    pages: ['/pricing', '/blog', '/contact', '/team', '/checkout', '/faq'],
    preloaded: 'Preloaded',
    used: 'Visited',
    unused: 'Unused',
    server: 'Server load',
  },
}[lang];
const visited = new Set([0, 4]);
---

<Figure lang={lang} steps={t.steps} summary={t.summary}>
  <div class={`waste ${finalStep(3)}`}>
    <ul class="tiles">
      {t.pages.map((page, i) => (
        <li class:list={['tile', visited.has(i) ? 'used' : 'unused']}>
          <b>{page}</b>
          <span class="st pre">{t.preloaded}</span>
          <span class="st res">{visited.has(i) ? t.used : t.unused}</span>
        </li>
      ))}
    </ul>
    <div class="server on" data-b="2">
      <span>{t.server}</span>
      <div class="bar">
        <i></i>
      </div>
    </div>
  </div>
</Figure>

<style>
  .waste {
    font-size: 14px;
  }
  .waste .tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  @container (min-width: 520px) {
    .waste .tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
  }
  .waste .tile {
    position: relative;
    margin: 0;
    height: 92px;
    padding: 12px 14px;
    border: 1.5px dashed var(--accent);
    border-radius: 8px;
    background: var(--card);
    line-height: 1.3;
    transition:
      opacity 0.4s,
      border-color 0.4s;
  }
  .tile b {
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
  }
  .st {
    position: absolute;
    left: 14px;
    bottom: 10px;
    font-size: 13px;
    font-weight: 600;
    transition: opacity 0.4s;
  }
  .pre {
    color: var(--accent-ink);
  }
  .res {
    opacity: 0;
  }
  .at-3 .pre {
    opacity: 0;
  }
  .at-3 .res {
    opacity: 1;
  }
  .at-3 .used {
    border-style: solid;
    border-color: var(--good);
  }
  .at-3 .used .res {
    color: var(--good);
  }
  .at-3 .unused {
    opacity: 0.5;
    border-color: var(--bad);
  }
  .at-3 .unused .res {
    color: var(--bad);
  }
  .server {
    margin-top: 20px;
  }
  .server span {
    display: block;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .bar {
    height: 14px;
    border-radius: 4px;
    background: var(--line);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 82%;
    background: var(--warn);
    transform-origin: left;
    transform: scaleX(0);
  }
  .server.on .bar i {
    transform: none;
    transition: transform 1.1s ease 0.15s;
  }
</style>
