---
/**
 * Where the page's blocks should sit (dashed) against where they ended up.
 * Each fix shrinks the shift until the layout lands in place.
 */
import Figure from './Figure.astro';
import Photo from './Photo.astro';
import { finalStep, type Lang } from './beats';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = {
  es: {
    summary:
      'Una página de ejemplo con la posición esperada de cada bloque en línea punteada y su posición real encima.',
    steps: [
      'Todo cae por debajo de donde debería estar',
      'Con width y height, el navegador reserva el espacio de la imagen',
      'Nada de contenido insertado encima: el espacio se reserva antes',
      'Fuentes precargadas: el texto no salta y el layout queda estable',
    ],
    expected: 'Dónde debería estar',
    actual: 'Dónde terminó',
    shift: 'desplazamiento',
  },
  en: {
    summary: 'An example page with the expected position of each block dashed and its actual position on top.',
    steps: [
      'Everything lands below where it should be',
      'With width and height, the browser reserves the image space',
      'No content inserted on top: the space is reserved first',
      'Preloaded fonts: the text does not jump and the layout settles',
    ],
    expected: 'Where it should be',
    actual: 'Where it ended up',
    shift: 'shift',
  },
}[lang];

/** Block geometry on the 460-unit-wide mock: top, height and an optional width or right inset. */
const blocks = [
  { top: 20, h: 18, w: '40%' },
  { top: 56, h: 140, photo: true },
  { top: 214, h: 26, right: 115 },
  { top: 254, h: 13 },
  { top: 277, h: 13, right: 164 },
  { top: 312, h: 44, w: '150u', button: true },
];
const geometry = (b: (typeof blocks)[number]) =>
  [
    `top:calc(${b.top} * var(--u))`,
    `height:calc(${b.h} * var(--u))`,
    b.w && `width:${b.w.endsWith('u') ? `calc(${parseFloat(b.w)} * var(--u))` : b.w}`,
    b.right && `right:calc(${b.right} * var(--u))`,
  ]
    .filter(Boolean)
    .join(';');
---

<Figure lang={lang} steps={t.steps} summary={t.summary}>
  <div class={`cls ${finalStep(4)}`}>
    <div class="mock">
      {blocks.map((b) => (
        <div class="blk ghost" style={geometry(b)} />
      ))}
      {blocks.map((b, i) => (
        <div class:list={['blk', 'real', { first: i === 0, button: b.button }]} style={geometry(b)}>
          {b.photo && <Photo />}
        </div>
      ))}
    </div>
    <div class="shift">
      <span>{t.shift}</span>
    </div>
    <ul class="legend">
      <li>
        <i class="sw ghost"></i>
        {t.expected}
      </li>
      <li>
        <i class="sw real"></i>
        {t.actual}
      </li>
    </ul>
  </div>
</Figure>

<style>
  .cls {
    --u: calc(100cqi / 800);
    --off: calc(107 * var(--u));
    --offc: var(--bad);
    position: relative;
    aspect-ratio: 800 / 380;
    font-size: max(10px, calc(15 * var(--u)));
  }
  .cls.at-2 {
    --off: calc(66 * var(--u));
    --offc: var(--warn);
  }
  .cls.at-3 {
    --off: calc(28 * var(--u));
  }
  .cls.at-4 {
    --off: 0px;
    --offc: var(--good);
  }
  .mock {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(460 * var(--u));
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .blk {
    position: absolute;
    left: calc(20 * var(--u));
    right: calc(20 * var(--u));
    border-radius: calc(5 * var(--u));
    overflow: hidden;
  }
  .ghost {
    border: 1.5px dashed var(--muted);
    opacity: 0.6;
    transition: opacity 0.4s;
  }
  .real {
    background: var(--skel);
    transform: translateY(var(--off));
    transition: transform 0.6s cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  .real.first {
    transform: none;
  }
  .real.button {
    background: var(--accent);
    opacity: 0.85;
  }
  .at-4 .mock .ghost,
  .at-4 .shift {
    opacity: 0;
  }
  .shift {
    position: absolute;
    left: calc(500 * var(--u));
    top: calc(56 * var(--u));
    width: calc(5 * var(--u));
    height: var(--off);
    background: var(--offc);
    border-radius: 3px;
    transition:
      height 0.6s ease,
      background 0.4s,
      opacity 0.4s;
  }
  .shift span {
    position: absolute;
    left: calc(16 * var(--u));
    top: 0;
    font-weight: 700;
    color: var(--offc);
    white-space: nowrap;
  }
  .cls .legend {
    position: absolute;
    left: calc(500 * var(--u));
    bottom: 0;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--u));
    color: var(--muted);
  }
  .cls .legend li {
    margin: 0;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
  }
  .sw {
    flex: none;
    width: calc(30 * var(--u));
    height: calc(16 * var(--u));
    border-radius: 3px;
  }
  .sw.real {
    transform: none;
    border: 1px solid var(--line);
  }
</style>
